# ============================================================
# Widget Service — Multi-stage Dockerfile
# ============================================================

# Stage 1: Build shared + widget
FROM node:24-alpine AS builder

RUN corepack enable

WORKDIR /app

# Copy workspace config
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
COPY packages/collector/package.json packages/collector/
COPY packages/frontend/package.json packages/frontend/
COPY packages/widget/package.json packages/widget/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/shared/ packages/shared/
COPY packages/widget/ packages/widget/

# Build shared first, then widget (tsc for Express server)
RUN pnpm --filter shared build && pnpm --filter widget build
# Build widget client (Vite for Preact embed bundle)
RUN pnpm --filter widget build:widget

# Stage 2: Runtime
FROM node:24-alpine AS runtime

RUN corepack enable

WORKDIR /app

# Copy workspace config for pnpm
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
COPY packages/collector/package.json packages/collector/
COPY packages/frontend/package.json packages/frontend/
COPY packages/widget/package.json packages/widget/

# Install production dependencies only
RUN pnpm install --frozen-lockfile --prod

# Copy built artifacts (both Express server and Preact client bundle)
COPY --from=builder /app/packages/shared/dist/ packages/shared/dist/
COPY --from=builder /app/packages/widget/dist/ packages/widget/dist/
COPY --from=builder /app/packages/widget/dist-widget/ packages/widget/dist-widget/

# Environment defaults
ENV NODE_ENV=production
ENV WIDGET_PORT=3211
ENV SERVER_URL=http://server:3000

EXPOSE 3211

VOLUME ["/app/storage"]

CMD ["node", "packages/widget/dist/index.js"]