# ============================================================
# Frontend — Multi-stage Dockerfile (Vite build + Nginx serve)
# ============================================================

# Stage 1: Build
FROM node:24-alpine AS builder

RUN corepack enable

WORKDIR /app

# Copy workspace config
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
COPY packages/collector/package.json packages/collector/
COPY packages/frontend/package.json packages/frontend/
COPY packages/widget/package.json packages/widget/

# Install dependencies (pnpm store persisted via BuildKit cache mount:
# avoids re-downloading the whole lockfile every build and caps peak disk usage)
RUN --mount=type=cache,id=pnpm-store-frontend,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Copy source code
COPY packages/shared/ packages/shared/
COPY packages/frontend/ packages/frontend/

# Build shared first, then frontend
RUN pnpm --filter shared build && pnpm --filter frontend build

# Stage 2: Nginx
FROM nginx:alpine AS runtime

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Self-signed TLS certificate generated at IMAGE BUILD (not committed —
# a private key must never ship in the repo; Phase 181 publication hardening).
# Dev/local only: production fronts this with a real reverse proxy + real cert.
RUN apk add --no-cache openssl && \
    mkdir -p /etc/nginx/certs && \
    openssl req -x509 -nodes -newkey rsa:2048 -days 3650 \
      -keyout /etc/nginx/certs/selfsigned.key \
      -out /etc/nginx/certs/selfsigned.crt \
      -subj "/CN=simmetric-chat-frontend" && \
    chmod 600 /etc/nginx/certs/selfsigned.key

# Copy custom nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built frontend assets
COPY --from=builder /app/packages/frontend/dist/ /usr/share/nginx/html/

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]