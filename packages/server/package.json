{
  "name": "@simmetric-chat/server",
  "version": "0.22.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/templates && cp src/templates/*.json dist/templates/",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:integration": "jest --config jest.config.integration.js --forceExit",
    "db:generate": "prisma generate && node scripts/fix-prisma-pnpm.cjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "audit:migrations": "tsx scripts/audit-migrations.ts",
    "db:migrate:guard": "tsx scripts/migrate-guard.ts",
    "db:migrate:reset:guard": "tsx scripts/migrate-reset-guard.ts",
    "check:build-freshness": "node scripts/check-build-freshness.cjs",
    "start": "node scripts/check-build-freshness.cjs && node dist/index.js",
    "generate-apikey": "node scripts/generate-widget-apikey.js",
    "rotate-encryption-key": "tsx scripts/rotate-encryption-key.ts",
    "verify-encryption-key": "tsx scripts/verify-encryption-key.ts",
    "license:check": "tsx scripts/check-license.ts",
    "smoke:ollama": "tsx src/smoke/ollamaJs.smoke.ts && node dist/smoke/ollamaJs.smoke.js",
    "smoke:license-e2e": "tsx scripts/smoke-license-e2e.ts",
    "smoke:multi-instance": "tsx scripts/smoke-multi-instance.ts"
  },
  "dependencies": {
    "@json2csv/plainjs": "^7.0.8",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "@simmetric-chat/shared": "workspace:*",
    "@tavily/core": "^0.7.8",
    "archiver": "^8.0.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dompurify": "^3.4.14",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "gray-matter": "^4.0.3",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsdom": "^29.1.1",
    "jsonrepair": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^14.3.0",
    "multer": "^2.2.0",
    "ollama": "^0.6.3",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "pg-boss": "^12.28.0",
    "prisma": "^7.10.0",
    "puppeteer": "^25.9.0",
    "rate-limit-redis": "^6.0.1",
    "redlock": "5.0.0-beta.2",
    "sharp": "^0.35.3",
    "simple-git": "^3.36.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.12",
    "turndown": "^7.2.4",
    "uuid": "^14.0.2",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/markdown-it": "^14.2.0",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/turndown": "^5.0.6",
    "@types/web-push": "^3.6.4",
    "commander": "^15.0.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@simmetric-chat/enterprise": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@simmetric-chat/enterprise": {
      "optional": true
    }
  }
}
