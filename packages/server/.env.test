DATABASE_URL=postgresql://simmetricchat:simmetricchat@localhost:5434/simmetricchat_test
JWT_SECRET=test-jwt-secret-for-unit-tests-32ch
NODE_ENV=test
COLLECTOR_SECRET=test-collector-secret-for-unit-tests
# WID-04: push HTTP cache-bust to widget service. WIDGET_API_KEY must match
# packages/widget WIDGET_API_KEY for the shared-secret auth handshake.
WIDGET_SERVICE_URL=http://localhost:3211
WIDGET_API_KEY=test-key
# Phase 163 (SCALE-03): base64 32-byte HMAC signing key for API keys. Unit
# tests use the real crypto.createHmac, so a real secret value is required.
# This decodes to 32 zero bytes (valid for HMAC in tests).
API_KEY_HMAC_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

