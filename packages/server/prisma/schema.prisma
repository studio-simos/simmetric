// ============================================================
// Unified Upload Drafts (Phase 68 — v0.12 Upload Consolidation)
// ============================================================

// UploadDraft — staging entity for the unified upload area (D-07).
// Two independent boolean flags `ragEnabled`/`kbEnabled` model the
// destination: "both" = both true; "unassigned" = both false.
// `parseStatus` is a plain String (NO Prisma enum) so the Phase 68
// migration stays additive (A4); type-safety is enforced at the Zod
// layer in plan 68-02 (D-05). Migration is applied in plan 68-04.
model UploadDraft {
  id                String    @id @default(uuid())
  // Phase 182 (SAAS-01b, D-02 promise list): draft reaper org-scoping lands
  // Phase 185; column now
  organizationId    String    @default("00000000-0000-0000-0000-000000000000")
  uploadedBy        String
  workspaceId       String
  assignedArchiveId String?
  ragEnabled        Boolean   @default(false)
  kbEnabled         Boolean   @default(false)
  filePath          String
  /// Phase 184 (SAAS-03, D-05): provider key. NEW rows: {organizationId}/uploads/drafts/{uuid}-{safeName};
  /// URL-sentinel drafts carry the URL itself (isDraftStorageKey = false — never deleted).
  /// LEGACY rows backfilled storageKey = filePath (path-as-key, M6 UPDATE — no file moves).
  /// Nullable, NO @default — write sites set it explicitly.
  storageKey        String?
  originalName      String
  fileSize          Int       @default(0)
  mimeType          String
  parseStatus String @default("uploaded")  // "uploaded" | "assigned" | "done" — NO Prisma enum (A4)
  ragJobId          String?   // soft FK to Document.id created by the RAG leg
  kbJobId           String?   // soft FK to ArchiveImportJob.id created by the KB leg
  expiresAt         DateTime
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations — D-01: onDelete Cascade on uploadedBy (user delete drags drafts)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  archive Archive? @relation(fields: [assignedArchiveId], references: [id], onDelete: SetNull)

  @@index([uploadedBy, deletedAt])
  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("upload_drafts")
}

// ============================================================
// Per-user-per-workspace Memory (Phase 97 — MEM-01 D-01)
//
// Pitfall 3 HIGHEST RISK security + GDPR invariant:
// - Memory is per-user-per-workspace (userId + workspaceId FKs).
//   IDOR routes filter `where: { userId, workspaceId }`.
// - `sourceMessageId` FK `onDelete: Cascade` (nullable for user-edited memories)
//   guarantees no orphan PII when ChatMessage rows are hard-purged (reaper Pass 2).
// - `sensitivity` field: `high` memories are stored for user review/delete but
//   NEVER injected into the agent system prompt (97-02 retrieval filter).
// - `embedding` is the first Prisma-managed pgvector column (Unsupported("vector(384)?")).
//   The `?` makes the column nullable so Prisma `create` works without an embedding;
//   embeddings are written via `$executeRaw` and read queries always `select` to
//   EXCLUDE `embedding` (Unsupported columns cannot be deserialized by Prisma).
// - `path` is a materialized dotted string (e.g. `preferences.theme`), NOT `ltree`.
//   Query via `LIKE 'preferences.%'` or prefix match in pathRank (97-02).
// - `@@unique([userId, workspaceId, path])` deduplicates memories per path per
//   user-per-workspace (Pitfall 3 dedup explosion).
// - `@@index([userId, workspaceId])` is the per-user-per-workspace query hot path.
// ============================================================

enum MemoryType {
  // User-authored or LLM-extracted fact about the user (preferences, enduring details).
  user
  // Contextual memory derived from a conversation (e.g. "user is debugging X today").
  context
}

enum MemorySensitivity {
  // Safe to inject into the agent system prompt.
  low
  // Inject with care (default — balances safety and utility).
  medium
  // Stored for user review/delete but NEVER injected (Pitfall 3 — high PII risk).
  high
}

model Memory {
  id             String           @id @default(uuid())
  userId         String
  workspaceId    String
  type           MemoryType
  // Materialized dotted path (e.g. `preferences.theme`). NON `ltree` — ROADMAP explicit.
  // Nullable: contextual memories may not have a structured path.
  path           String?
  content        String
  // FK to the ChatMessage the memory was extracted from. Nullable for user-edited
  // memories (created via POST /api/memories, no source message). onDelete: Cascade
  // — Pitfall 3 no orphan PII: when the source message is hard-purged, the derived
  // memory is purged too (reaper Pass 2 adds an explicit Memory.deleteMany for audit).
  sourceMessageId String?
  sensitivity    MemorySensitivity @default(low)
  // Prisma-managed pgvector column (first server-side use). Unsupported columns can
  // only be written via `$executeRaw` UPDATE; they CANNOT be set in `prisma.create`
  // and CANNOT be deserialized in `findMany` without a `select` that excludes them.
  embedding      Unsupported("vector(384)?")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations — Pitfall 3 per-user-per-workspace invariant.
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceMessage ChatMessage?  @relation("ChatMessageSourceMemories", fields: [sourceMessageId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, path])
  @@index([userId, workspaceId])
  @@map("memories")
}

// ============================================================
// DLP pattern configuration (quick 260829-ony — DLP_FEATURES_SPEC §2.3)
//
// DB-backed PII patterns replacing the hardcoded DLP_PATTERNS const as the
// source of truth (the const stays as fallback when the DB is unreachable).
// - 6 built-in rows seeded idempotently by the migration SQL (isBuiltIn true);
//   admins toggle them but can never change their regex (spec §4.4 — PUT on a
//   built-in accepts ONLY displayName + isEnabled).
// - Custom patterns are GLOBAL (no workspaceId — spec §4.8), capped at 50 per
//   instance (spec §4.9), ordered createdAt ASC built-ins-first (§4.3).
// - The service layer compiles `pattern`+`patternFlags` into a RegExp and
//   caches it per row id (spec §2.4 performance note).
// - Soft deletes: DLP audit history references pattern NAMES in metadata, not
//   FKs, so a hard delete is the right semantics here (deleting a custom
//   pattern must stop scanning with it immediately) — no deletedAt column
//   (deviates from the soft-delete norm on purpose; spec fields have none).
// ============================================================

model DlpPattern {
  id           String   @id @default(uuid())
  // Phase 182 (Tier A′): per-tenant DLP — built-in seeded patterns pin to the
  // default org via M3 backfill; custom patterns become per-org (spec §4.8).
  // organizationId NON-NULL with default (DlpPattern has NO deletedAt, so the
  // composite is PLAIN — no partial where). This is the ONLY existing-unique
  // rewrite in the phase (D-06 freeze).
  organizationId String @default("00000000-0000-0000-0000-000000000000")
  // Stable machine name, snake_case per shared dlp.schema.ts — the conflict
  // target for the built-in seed and the audit-log identifier. Unique scope
  // widened to (organizationId, name) in Phase 182.
  name         String
  // Admin-facing label ("Email", "Italian Fiscal Code").
  displayName  String
  // Regex SOURCE string (no /…/ delimiters), e.g. "[A-Z]{6}\d{2}[A-Z]\d{2}[A-Z]\d{5}".
  pattern      String   @db.Text
  // Regex flags shipped to the RegExp constructor ("gu" default — unicode
  // like the built-ins; kept as a column per spec §2.3).
  patternFlags String   @default("gu")
  // Replacement applied on redaction ("[REDACTED]" default).
  replacement  String   @default("[REDACTED]")
  isEnabled    Boolean  @default(true)
  // true for the 6 seeded originals — regex frozen, only toggle+rename allowed.
  isBuiltIn    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("dlp_patterns")
}

