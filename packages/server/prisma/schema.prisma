model SynthesisRun {
  id                  String              @id @default(uuid())
  // Phase 182 (SAAS-01b, D-02 promise list): org transitivo via archiveId
  organizationId      String              @default("00000000-0000-0000-0000-000000000000")
  archiveId           String
  status              SynthesisRunStatus  @default(PENDING)
  // D-10: human-readable, editable name. Non-nullable with a default of "" so
  // the additive migration is Phase 58-safe; the backfill UPDATE populates
  // existing rows with "Sintesi · {archive.name} · {DD/MM/YYYY HH:mm}", and
  // the create path (runSynthesisPipeline + /trigger) sets it at creation.
  name                String              @default("")
  pagesRead           Int                 @default(0)
  pagesWritten        Int                 @default(0)
  // D-02: distinguish proposed (non-SKIP changes pushed to preview) from
  // applied (real writes after approve). pagesWritten is kept for backward
  // compatibility but set to 0 at pipeline time (nothing is applied until
  // the user approves). Both columns are additive (Phase 58-safe).
  pagesProposed       Int                 @default(0)
  pagesApplied        Int                 @default(0)
  tokensUsed          Int                 @default(0)
  llmCallsUsed        Int                 @default(0)
  contradictionsFound Int                 @default(0)
  previewJson         Json?
  error               String?             @db.Text
  approvedBy          String?
  // D-14: createdAt + 2h; reaper flips PROCESSING→FAILED when expiresAt < now
  expiresAt           DateTime?
  createdBy           String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  archive  Archive  @relation(fields: [archiveId], references: [id])
  creator  User     @relation("SynthesisRunCreator", fields: [createdBy], references: [id])
  approver User?    @relation("SynthesisRunApprover", fields: [approvedBy], references: [id])

  @@index([archiveId, createdAt])
  @@index([archiveId, status])
  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("synthesis_runs")
}

