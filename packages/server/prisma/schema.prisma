// ============================================================
// Per-user-per-workspace Memory (Phase 97 — MEM-01 D-01)
//
// Pitfall 3 HIGHEST RISK security + GDPR invariant:
// - Memory is per-user-per-workspace (userId + workspaceId FKs).
//   IDOR routes filter `where: { userId, workspaceId }`.
// - `sourceMessageId` FK `onDelete: Cascade` (nullable for user-edited memories)
//   guarantees no orphan PII when ChatMessage rows are hard-purged (reaper Pass 2).
// - `sensitivity` field: `high` memories are stored for user review/delete but
//   NEVER injected into the agent system prompt (97-02 retrieval filter).
// - `embedding` is the first Prisma-managed pgvector column (Unsupported("vector(384)?")).
//   The `?` makes the column nullable so Prisma `create` works without an embedding;
//   embeddings are written via `$executeRaw` and read queries always `select` to
//   EXCLUDE `embedding` (Unsupported columns cannot be deserialized by Prisma).
// - `path` is a materialized dotted string (e.g. `preferences.theme`), NOT `ltree`.
//   Query via `LIKE 'preferences.%'` or prefix match in pathRank (97-02).
// - `@@unique([userId, workspaceId, path])` deduplicates memories per path per
//   user-per-workspace (Pitfall 3 dedup explosion).
// - `@@index([userId, workspaceId])` is the per-user-per-workspace query hot path.
// ============================================================

enum MemoryType {
  // User-authored or LLM-extracted fact about the user (preferences, enduring details).
  user
  // Contextual memory derived from a conversation (e.g. "user is debugging X today").
  context
}

enum MemorySensitivity {
  // Safe to inject into the agent system prompt.
  low
  // Inject with care (default — balances safety and utility).
  medium
  // Stored for user review/delete but NEVER injected (Pitfall 3 — high PII risk).
  high
}

model Memory {
  id             String           @id @default(uuid())
  userId         String
  workspaceId    String
  type           MemoryType
  // Materialized dotted path (e.g. `preferences.theme`). NON `ltree` — ROADMAP explicit.
  // Nullable: contextual memories may not have a structured path.
  path           String?
  content        String
  // FK to the ChatMessage the memory was extracted from. Nullable for user-edited
  // memories (created via POST /api/memories, no source message). onDelete: Cascade
  // — Pitfall 3 no orphan PII: when the source message is hard-purged, the derived
  // memory is purged too (reaper Pass 2 adds an explicit Memory.deleteMany for audit).
  sourceMessageId String?
  sensitivity    MemorySensitivity @default(low)
  // Prisma-managed pgvector column (first server-side use). Unsupported columns can
  // only be written via `$executeRaw` UPDATE; they CANNOT be set in `prisma.create`
  // and CANNOT be deserialized in `findMany` without a `select` that excludes them.
  embedding      Unsupported("vector(384)?")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations — Pitfall 3 per-user-per-workspace invariant.
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceMessage ChatMessage?  @relation("ChatMessageSourceMemories", fields: [sourceMessageId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, path])
  @@index([userId, workspaceId])
  @@map("memories")
}

// ============================================================
// DLP pattern configuration (quick 260829-ony — DLP_FEATURES_SPEC §2.3)
//
// DB-backed PII patterns replacing the hardcoded DLP_PATTERNS const as the
// source of truth (the const stays as fallback when the DB is unreachable).
// - 6 built-in rows seeded idempotently by the migration SQL (isBuiltIn true);
//   admins toggle them but can never change their regex (spec §4.4 — PUT on a
//   built-in accepts ONLY displayName + isEnabled).
// - Custom patterns are GLOBAL (no workspaceId — spec §4.8), capped at 50 per
//   instance (spec §4.9), ordered createdAt ASC built-ins-first (§4.3).
// - The service layer compiles `pattern`+`patternFlags` into a RegExp and
//   caches it per row id (spec §2.4 performance note).
// - Soft deletes: DLP audit history references pattern NAMES in metadata, not
//   FKs, so a hard delete is the right semantics here (deleting a custom
//   pattern must stop scanning with it immediately) — no deletedAt column
//   (deviates from the soft-delete norm on purpose; spec fields have none).
// ============================================================

model DlpPattern {
  id           String   @id @default(uuid())
  // Phase 182 (Tier A′): per-tenant DLP — built-in seeded patterns pin to the
  // default org via M3 backfill; custom patterns become per-org (spec §4.8).
  // organizationId NON-NULL with default (DlpPattern has NO deletedAt, so the
  // composite is PLAIN — no partial where). This is the ONLY existing-unique
  // rewrite in the phase (D-06 freeze).
  organizationId String @default("00000000-0000-0000-0000-000000000000")
  // Stable machine name, snake_case per shared dlp.schema.ts — the conflict
  // target for the built-in seed and the audit-log identifier. Unique scope
  // widened to (organizationId, name) in Phase 182.
  name         String
  // Admin-facing label ("Email", "Italian Fiscal Code").
  displayName  String
  // Regex SOURCE string (no /…/ delimiters), e.g. "[A-Z]{6}\d{2}[A-Z]\d{2}[A-Z]\d{5}".
  pattern      String   @db.Text
  // Regex flags shipped to the RegExp constructor ("gu" default — unicode
  // like the built-ins; kept as a column per spec §2.3).
  patternFlags String   @default("gu")
  // Replacement applied on redaction ("[REDACTED]" default).
  replacement  String   @default("[REDACTED]")
  isEnabled    Boolean  @default(true)
  // true for the 6 seeded originals — regex frozen, only toggle+rename allowed.
  isBuiltIn    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("dlp_patterns")
}

// ============================================================
// Phase 192 (DLP-01..04, D-03/D-04): document-scan entity mapping.
//
// The mapping table IS the re-composition source of truth (D-04): chat
// re-composition and preview unmask = decrypt originalEncrypted + substitute
// the placeholder. Each row pins ONE entity occurrence-class discovered in a
// document:
// - entityClass: one of the shared DLP_ENTITY_CLASSES (PERSON, ADDRESS,
//   FINANCIAL, GOV_ID, CONTACT) — never re-declared per package (D-02).
// - placeholder: the instance-numbered token, e.g. [PERSON_1] — occurrence-
//   stable across the whole document text + all chunks (D-03 normalization
//   pass runs BEFORE chunking references).
// - originalEncrypted: encryptionService.encrypt() output (AES-256-GCM,
//   ENCRYPTION_KEY contract unchanged) — NEVER a plaintext column (D-04
//   one-way door; the only clean copy lives here + the encrypted original).
// - chunkId optional: document-wide entities (normalization pass) may not
//   pin a single chunk when the same placeholder spans chunk boundaries.
// - occurrences: match count for the entity within the document (dedup
//   accounting for the eval FP metric).
// Additive-only (D-04); document deletion cascades the mapping rows so no
// orphan encrypted ciphertext survives a document purge (no-orphan-PII
// invariant, mirrors Memory.sourceMessageId cascade rationale).
// ============================================================

model DlpEntity {
  id                String   @id @default(uuid())
  documentId        String
  /// Optional chunk anchor — document-wide entities may not pin one chunk.
  chunkId           String?
  /// One of shared DLP_ENTITY_CLASSES (PERSON|ADDRESS|FINANCIAL|GOV_ID|CONTACT).
  entityClass       String
  /// Instance-numbered placeholder token, e.g. [PERSON_1] (D-03).
  placeholder       String
  /// encryptionService.encrypt() output — never plaintext (D-04).
  originalEncrypted String   @db.Text
  occurrences       Int      @default(1)
  createdAt         DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("dlp_entities")
}

// SSO models (SsoConfig, IdentityProvider, ScimGroup) moved to
// schema-enterprise.prisma (Phase 143 D-04, Phase 141 verdict (a)).
// `prismaSchemaFolder` (directory mode in prisma.config.ts — Phase 142 D-08)
// merges that fragment with this file at `prisma generate` time, so the
// generated client still has the `prisma.ssoConfig` / `prisma.identityProvider`
// / `prisma.scimGroup` delegates. The `User.identityProviders` back-relation
// (above, in the User model) stays here — the cross-fragment relation is
// resolved by the prismaSchemaFolder merge (Phase 141 spike verified).
// ============================================================
// External Chat Connectors (Phase 198, ECCO-01 D-01 — spec §7.3 v2)
// ============================================================

// Chat-inbound connectors: one row per external bot (Telegram v1; the enum
// union widens in Phases 199/200 — adapter registry fails closed for
// unimplemented platforms). Secrets live ONLY in the two AES-256-GCM blobs
// (encryptionService): botTokenEncrypted (the platform bot token) and
// configEncrypted (per-platform JSON config INCL. signing/app secrets).
// pollOffset BigInt (TV-2: Telegram update_id tends to int32 overflow on a
// multi-year horizon — the repo's first BigInt column). healthStatus follows
// the enum-as-string precedent (MCPConnection.healthStatus).
model ChatConnector {
  id                 String   @id @default(uuid())
  // Phase 182 (SAAS-01b): org resolution point for connector sessions
  // (sentinel default mirrors Widget) — webhooks are PUBLIC routes that
  // resolve the row from the DB by its id (never from the body) and stash
  // req.tenantConnector fail-closed (WR-05 slot).
  organizationId     String   @default("00000000-0000-0000-0000-000000000000")
  platform           String   // "telegram" | "discord" | "slack" | "whatsapp"
  name               String
  botTokenEncrypted  String?  // AES-256-GCM (encryptionService)
  configEncrypted    String?  // platform config INCL. signing/app secret (JSON cifrato)
  workspaceId        String   // KB binding (hard FK, come widget primary)
  archiveId          String?  // opzionale, pseudo-workspace "archive:<id>" come widget
  responseProviderId String?  // model pin, mirror Widget (server-resolved, mai client)
  responseModel      String?
  botUsername        String?
  botDisplayName     String?
  welcomeMessage     String?  @db.Text
  fallbackMessage    String?  @db.Text  @default("I don't have an answer for that. Please contact us for more help.")
  fallbackLocale     String   @default("en")
  localizedTexts     Json?    // mirror Widget v0.20
  isEnabled          Boolean  @default(true)
  pollMode           String   @default("polling") // "polling" | "webhook" (Telegram-only semantics in Phase 198)
  pollOffset         BigInt   @default(0) // Telegram update_id cursor — BigInt per spec §7.2-5 (int32 overflow horizon)
  rateLimitPerMinute Int?     // override, null = default globale
  sessionLimitPerDay Int?     // mirror Widget G-151-1b
  healthStatus       String   @default("unknown") // "unknown" | "healthy" | "error"
  lastWebhookAt      DateTime?
  lastPollAt         DateTime?
  lastError          String?  @db.Text
  createdBy          String
  deletedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator      User             @relation("ConnectorCreator", fields: [createdBy], references: [id])
  sessions     ConnectorSession[]
  messages     ConnectorMessage[]

  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@index([workspaceId, isEnabled])
  @@index([platform, isEnabled])
  @@map("chat_connectors")
}

// External chat session per (connector, platformUserId) — resolved server-side
// from the unique pair (NO sessionToken: no iframe carries it, unlike
// WidgetSession). A persistent Chat (service-account owned) is attached on the
// first message via chatId (D-08); expiresAt TTL refreshes on activity
// (WidgetSession precedent). Sessions hard-expire — never soft-deleted.
model ConnectorSession {
  id                String    @id @default(uuid())
  connectorId       String
  platformUserId    String
  platformUserName  String?
  chatId            String?   // Chat persistente (service account owner)
  messageCount      Int       @default(0)
  lastMessageAt     DateTime?
  lastResetAt       DateTime  @default(now())
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  connector ChatConnector      @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  chat      Chat?              @relation("ConnectorChat", fields: [chatId], references: [id], onDelete: SetNull)
  messages  ConnectorMessage[]

  @@unique([connectorId, platformUserId])
  @@index([expiresAt])
  @@map("connector_sessions")
}

// Append-only connector message log — the DB dedup arbiter AND the analytics
// instrument (spec §7.2-3: the @@unique constraint + the audit trail are the
// same instrument). A NULL platformMessageId row skips dedup semantics
// naturally in Postgres (NULLs never collide in a unique index). Never
// soft-deleted.
model ConnectorMessage {
  id                String   @id @default(uuid())
  connectorId       String
  sessionId         String
  direction         String   // "in" | "out"
  platformMessageId String?
  charCount         Int      @default(0)
  createdAt         DateTime @default(now())

  connector ChatConnector      @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  session   ConnectorSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([connectorId, platformMessageId]) // dedup (null platformMessageId = skip dedup)
  @@index([connectorId, createdAt])
  @@map("connector_messages")
}
