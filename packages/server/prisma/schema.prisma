// Prisma Schema — PostgreSQL Native
// PostgreSQL-only after Phase 22 (Infrastructure Foundation).

generator client {
  provider = "prisma-client-js"
  // D-Prisma7: in Prisma 7, `prisma-client-js` requires an explicit `output` path.
  // We generate into the package-local node_modules (where pnpm hoists nothing)
  // and then symlink node_modules/@prisma/client/.prisma -> ../.prisma/client
  // so the runtime require chain `default.js -> .prisma/client/default -> client.js` works.
  output   = "../node_modules/.prisma/client"
  // Phase 182 (D-05 spike): partial unique index WHERE "deletedAt" IS NULL on
  // OrganizationMember's composite unique — soft-deleted membership rows free
  // the (organizationId, userId) slot for re-add (P2002 tombstone class).
  // PREVIEW in Prisma 7.10.0 (introduced 7.4.0, NOT deprecated — unlike
  // prismaSchemaFolder, which the enterprise fragment header bans).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// RBAC Models
// ============================================================

// ============================================================
// Multi-Tenancy Root (Phase 182 — Tenant Data Model)
// ============================================================

// Organization — the tenancy root. A fixed-UUID "default" org (see
// DEFAULT_ORG_ID in @simmetric-chat/shared) is INSERTed by migration M1
// (NOT the seed — fresh installs run migrate-before-seed and tolerate seed
// failure). Air-gap installs keep behaving single-tenant: every pre-tenancy
// row backfills into the default org (M3) and every new row defaults to it
// (@default(DEFAULT_ORG_ID) on organizationId columns, M4 SET DEFAULT).
model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  // Phase 183/Parte II consume; default-org stays 'free'
  plan      String    @default("free")
  // Soft-delete norm (org deletion = Parte II provisioning story)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  members OrganizationMember[]
  // Back-relations for the Tier-A organizationId columns (Phase 182)
  projects             Project[]
  workspaces           Workspace[]
  chats                Chat[]
  chatFolders          ChatFolder[]
  chatMessages         ChatMessage[]
  documents            Document[]
  archives             Archive[]
  systemConfigs        SystemConfig[]
  providers            Provider[]
  providerModels       ProviderModel[]
  apiKeys              ApiKey[]
  workspaceAgentConfigs WorkspaceAgentConfig[]
  projectAccesses      ProjectAccess[]
  workspaceAccesses    WorkspaceAccess[]
  widgets              Widget[]
  widgetWorkspaces     WidgetWorkspace[]
  workspaceTemplates   WorkspaceTemplate[]
  workspaceTokenUsages WorkspaceTokenUsage[]
  webhooks             Webhook[]
  pushSubscriptions    PushSubscription[]
  mcpConnections       MCPConnection[]
  uploadDrafts         UploadDraft[]
  ocrJobs              OcrJob[]
  archiveImportJobs    ArchiveImportJob[]
  synthesisRuns        SynthesisRun[]
  dlpPatterns          DlpPattern[]
  // Phase 198 (ECCO-01, D-01): chat-inbound connectors are org-owned rows
  // (SAAS-01b sentinel below) — additive back-relation.
  connectors           ChatConnector[]
  // Cross-fragment back-relation (schema-enterprise.prisma BackupDestination
  // organizationId — resolves via the prismaSchemaFolder merge, Phase 141
  // verdict; mirrors User.backupDestinations)
  backupDestinations   BackupDestination[]

  @@map("organizations")
}

// OrganizationMember — the ONLY user↔organization link (D-01: User is a
// pure-identity entity, NO organizationId column on User). Removal of a
// member = soft delete of this row (D-04); user-created data stays owned
// by the org — no cascade of tenant data. roleInOrg is a tier ABOVE the
// 31-permission RBAC surface (untouched).
model OrganizationMember {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  // owner | admin | member — enum-as-string pattern (NOT Prisma enum) for
  // consistency with Chat.titleSource (Phase 182 research A8).
  roleInOrg      String    @default("member")
  // D-04: removal = soft delete; seat count = deletedAt IS NULL
  deletedAt      DateTime?
  joinedAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // D-05 (Phase 182): partial unique — soft-deleted rows (tombstones) free
  // the (organizationId, userId) slot so a member can be re-added (P2002
  // tombstone class seen across ×20 soft-deleting tables in v0.20).
  @@unique([organizationId, userId], where: { deletedAt: null })
  // "all orgs for user" lookup (TenantContext resolution hot path, Phase 185)
  @@index([userId])
  // seat-count / member-list queries
  @@index([organizationId])
  @@map("organization_members")
}

model User {
  id           String          @id @default(uuid())
  username     String          @unique
  email        String          @unique
  passwordHash String
  salt         String
  firstName     String?
  lastName      String?
  avatar        String?
  customInstructions String? @db.Text
  textSize      String?
  mustChangePassword Boolean    @default(false)
  // Phase 189 (WSIS-01 D-03): onboarding state — distinguishes the two empty
  // states (guided first-workspace wizard vs "no access, ask admin").
  hasOnboarded Boolean         @default(false)
  // Phase 206 (D-05): agency lifecycle — fail-closed disable. Login rejects
  // (401, account.disabled) and the auth chain fails closed while set; the
  // agency (or admin) can clear it to restore access. Data untouched; the
  // UserSponsorship row survives a disable (ceiling counts it until delete).
  disabledAt    DateTime?
  // Phase 206 (D-11): sub-user creation ceiling — admin-only edit. NULL
  // resolves to 0 (fail-closed): a user cannot sponsor until an admin sets
  // the ceiling. Breach arm returns { error, quota: "users" } (D-12).
  maxSponsoredUsers Int?
  // Phase 207 (D-07): per-user quota settings — additive nullable columns
  // (206 D-11 idiom). Resolution chain per D-08: per-user override >
  // install preset (systemConfigService DB > ENV > default) > unlimited
  // (fail-open — unset means zero behavior change for existing installs).
  // The *Unlimited booleans exempt a user from a live preset without
  // sentinel values (D-07). resetAnchorDate is the admin-set start date for
  // the recurring 30-day token-quota reset (CLOUD-06, D-11); NULL = manual
  // reset only.
  tokenQuotaLimit Int?
  storageQuotaGb Decimal? @db.Decimal(12, 2)
  tokenQuotaUnlimited Boolean @default(false)
  storageQuotaUnlimited Boolean @default(false)
  resetAnchorDate DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  roles           UserRole[]
  // Phase 182 (D-01): memberships are the ONLY org link — User carries NO
  // organizationId column (identity stays pure); the active org resolves
  // from request context via TenantContext (Phase 185).
  organizationMemberships OrganizationMember[]
  projectAccess   ProjectAccess[]
  workspaceAccess WorkspaceAccess[]
  apiKeys         ApiKey[]
  createdProjects Project[]      @relation("ProjectCreator")
  eventLogs       EventLog[]
  widgets         Widget[]
  chatPins        ChatPin[]
  mcpPins         ChatMCPPin[]
  archives        Archive[]
  archivePages    ArchivePage[]
  ocrJobs         OcrJob[]
  synthesisRuns          SynthesisRun[]  @relation("SynthesisRunCreator")
  approvedSynthesisRuns  SynthesisRun[]  @relation("SynthesisRunApprover")
  wikiEditRuns           WikiEditRun[]  @relation("WikiEditRunCreator")
  approvedWikiEditRuns   WikiEditRun[]  @relation("WikiEditRunApprover")
  archiveImportJobs      ArchiveImportJob[]
  backupDestinations     BackupDestination[]
  restoredBackups        BackupLog[]     @relation("restoredByUserRelation")
  uploadDrafts UploadDraft[]
  // Phase 97 (MEM-01 D-01 — Pitfall 3 per-user): memories authored by this user.
  // onDelete: Cascade via Memory.userId FK — user deletion cascades their memories (GDPR).
  memories Memory[]
  // Phase 113 (SSO): external identity provider links for this user (SAML/OIDC).
  // onDelete: Cascade via IdentityProvider.userId FK — user deletion removes their IdP links.
  identityProviders IdentityProvider[]
  // Phase 190 (SKIL-01 D-02): skills owned by this user (personal scope) +
  // skills this user created (owner track for the D-07 owner/admin gate).
  skills        AgentSkill[]   @relation("AgentSkillUser")
  createdSkills AgentSkill[]   @relation("AgentSkillCreator")
  // Phase 198 (ECCO-01, D-01): connectors this user created (creator track,
  // mirrors createdProjects "ProjectCreator" — explicit relation name because
  // ChatConnector.createdBy resolves to User).
  connectorsCreated ChatConnector[] @relation("ConnectorCreator")
  // Phase 206 (D-01): sponsorship hierarchy — the ONLY owner link. User stays
  // identity-pure (Phase 182 D-01): ownership lives in UserSponsorship, NOT a
  // parent FK column and NOT OrganizationMember.roleInOrg.
  sponsoredBy   UserSponsorship[] @relation("SponsorshipSponsor")
  sponsoredUsers UserSponsorship[] @relation("SponsorshipSubUser")
  // Phase 206 (D-09): per-user delegation grants (lattice: ⊆ sponsor's
  // effective permissions, validated server-side).
  permissionOverrides UserPermissionOverride[]
  // Phase 207 (D-02): reset ledger — anchor rows bound each rolling quota
  // window; usage/cost history is NEVER deleted or zeroed (203 doctrine).
  quotaResets QuotaReset[]

  @@map("users")
}

// Phase 207 (CLOUD-06, D-02): quota reset ledger. A reset writes an anchor
// row; the rolling window for a user/kind = ledger rows with createdAt > the
// latest anchor. Manual (admin/sponsor) and cron sweeps write the SAME row
// shape. Partial-unique backstop makes concurrent double-inserts impossible
// (cron idempotency, D-11); the latest-anchor re-check inside the inserting
// transaction is the primary guard (agencyUserService ceiling pattern).
model QuotaReset {
  id          String   @id @default(uuid())
  userId      String
  // "tokens" | "storage" — string, NOT a Prisma enum (repo A4 idiom; kinds
  // extend additively). Only "tokens" resets today — storage is a cap, not a
  // rolling allowance (D-12).
  kind        String
  at          DateTime @default(now())
  // "manual" (admin/sponsor route) | "cron" (quotaResetJob sweep).
  triggeredBy String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Idempotency backstop (D-11): one anchor per user/kind/timestamp. The
  // partial-index preview feature is enabled in the generator; a plain
  // unique on (userId, kind, at) is equivalent here because `at` is always
  // set by the writer (now() at insert time — two writers in the same
  // instant are exactly the race this index must break).
  @@unique([userId, kind, at])
  @@index([userId, kind, at])
  @@map("quota_resets")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
    description String? @db.Text
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users       UserRole[]
  permissions RolePermission[]
  menuSections RoleMenuSection[]
  // Phase 193 (LDAP-02, D-04): back-relation to the enterprise-fragment
  // LdapGroupRoleMap model (cross-fragment relation resolves at generate
  // time per the Phase 141 verdict — prismaSchemaFolder merge).
  ldapGroupRoleMaps LdapGroupRoleMap[]
  // Phase 206 (D-14): DB-driven per-role settings-section visibility rows
  // (admin-managed); menu sections continue to ride RoleMenuSection.
  sectionVisibilities RoleSectionVisibility[]

  @@map("roles")
}

// Enum-as-table pattern for SQLite compatibility.
// Each row represents a single permission name (e.g. "workspace:read").
model Permission {
  name        String           @id
    description String? @db.Text
  roles       RolePermission[]
  // Phase 206 (D-09): per-user delegation grants referencing this permission.
  userOverrides UserPermissionOverride[]

  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  // Phase 189 (WSIS-02 D-24, pulled forward from LDAP Phase 193 §3.3):
  // provenance of the assignment — "manual" | "ldap" | "sso" (enum-as-string,
  // Chat.titleSource idiom). LDAP sync (Phase 193) deletes only assignedVia
  // 'ldap' rows; backfilled legacy rows are 'manual'.
  assignedVia String @default("manual")
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId         String
  permissionName String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionName], references: [name], onDelete: Cascade)

  @@id([roleId, permissionName])
  @@map("role_permissions")
}

model RoleMenuSection {
  roleId      String
  menuSection String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, menuSection])
  @@map("role_menu_sections")
}

// Phase 206 (D-01): the ONLY ownership link for the 2-level web-agency
// hierarchy (sponsor → sub-user). Join table, not a parent FK on User —
// keeps User identity-pure (Phase 182 D-01) and is queryable both
// directions (list-my-sub-users AND find-my-sponsor). D-03: a row here
// marks the subUserId as structurally unable to sponsor (3rd-level guard,
// enforced again at the create route).
model UserSponsorship {
  id        String    @id @default(uuid())
  sponsorId String
  subUserId String
  // D-05 soft-delete norm: removal tombstones the row (mirrors
  // OrganizationMember D-04) — disable keeps the row; only a future delete
  // frees the ceiling slot.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sponsor User @relation("SponsorshipSponsor", fields: [sponsorId], references: [id], onDelete: Cascade)
  subUser User @relation("SponsorshipSubUser", fields: [subUserId], references: [id], onDelete: Cascade)

  // Active-ownership unique (tombstoned rows free the slot) — also the
  // P2002 arm for the ceiling TOCTOU defense (Plan 04).
  @@unique([sponsorId, subUserId], where: { deletedAt: null })
  @@index([subUserId])
  @@map("user_sponsorships")
}

// Phase 206 (D-09): per-user delegation grants. A sub-user's effective
// permissions = role defaults ∪ grants, always validated ⊆ the SPONSOR's
// effective set at submit time (server-side, D-08/D-10). Deleting a grant
// row = revoking it (no role churn).
model UserPermissionOverride {
  userId         String
  permissionName String
  grantedBy      String
  createdAt      DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionName], references: [name], onDelete: Cascade)

  @@id([userId, permissionName])
  @@map("user_permission_overrides")
}

// Phase 206 (D-14): DB-driven per-role settings-section visibility.
// menu sections keep riding RoleMenuSection (string-keyed, additive);
// THIS table covers the settings sections (SETTINGS_TAB_PERMISSIONS keys).
// Absent row = permission-OR default (fail-open to CURRENT behavior —
// byte-identical fallback, VIS-01 default clause).
model RoleSectionVisibility {
  roleId     String
  sectionKey String
  visible    Boolean

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, sectionKey])
  @@map("role_section_visibilities")
}

model ProjectAccess {
  userId    String
  projectId String
  // Phase 182 (SAAS-01b): access grant pins its org (column only — composite
  // PK untouched)
  organizationId String @default("00000000-0000-0000-0000-000000000000")
  grantedAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  // Phase 182 (SAAS-01b): org-lookup index on the M2 column — declared here so
  // `prisma migrate dev` drift detection keeps the M2-created DB index (the
  // Plan-02 empirical probe proved Prisma proposes DROP INDEX for any DB index
  // absent from the schema).
  @@index([organizationId])
  @@map("project_access")
}

model WorkspaceAccess {
  userId      String
  workspaceId String
  // Phase 189 (WSIS-02 D-07/D-24): persisted graded role — "owner" | "editor"
  // | "viewer" (enum-as-string, Chat.titleSource idiom). Legacy rows backfill
  // to "editor" (D-12, NOT the spec's viewer suggestion).
  role String @default("viewer")
  // Phase 189 (WSIS-02 D-07/D-24): grantor provenance — NULL marks legacy rows
  // (audit-distinguishable from admin-granted rows, D-12).
  grantedBy String?
  // Phase 182 (SAAS-01b): access grant pins its org (column only — composite
  // PK untouched)
  organizationId String @default("00000000-0000-0000-0000-000000000000")
  grantedAt   DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("workspace_access")
}

// ============================================================
// Domain Models
// ============================================================

model Project {
  id            String    @id @default(uuid())
  // Phase 182 (SAAS-01b): tenant owner. @default pins the air-gap default org —
  // zero create()-site churn until TenantContext replaces it (Phase 185).
  organizationId String   @default("00000000-0000-0000-0000-000000000000")
  // Phase 182 (SAAS-01b): tenant owner. @default pins the air-gap default org —
  // zero create()-site churn until TenantContext replaces it (Phase 185).
    name          String
    description String? @db.Text
  createdBy   String
  deletedAt   DateTime?
  // Phase 189 (WSIS-01 D-02): explicit personal-workspace flag — the single
  // source of truth for the max_workspaces exemption. The spec §5.7
  // name-convention sketch (name === "Personal") was REJECTED per D-02
  // (a rename would flip license accounting).
  isPersonal  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator      User           @relation("ProjectCreator", fields: [createdBy], references: [id])
  workspaces   Workspace[]
  accessGrants ProjectAccess[]
  mcpConnections MCPConnection[]

  // D-01 (quick 260809-wte): unique per-owner name, partial index WHERE "deletedAt" IS NULL (soft-deleted rows free the name).
  @@unique([createdBy, name])
  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("projects")
}

model Workspace {
  id             String   @id @default(uuid())
  // Phase 182 (SAAS-01b): tenancy boundary for collector/vector layer
  organizationId String   @default("00000000-0000-0000-0000-000000000000")
  projectId      String
  name           String
    instructions   String? @db.Text
  embeddingModel String   @default("Xenova/all-MiniLM-L6-v2")
  allowMemberUploads Boolean @default(true)
  // Phase 192 (D-05): per-workspace document-scan toggle. Implemented as a
  // Workspace column per research A3/Pitfall-8 recommendation — the
  // SystemConfig cascade is org-granular and cannot scope per-workspace; the
  // column delivers the same admin-UI surface with honest workspace scoping.
  // Default off (DLP-05 eval gate must pass before enablement).
  dlpDocumentScanEnabled Boolean @default(false)
  icon           String?
  templateId     String?
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template      WorkspaceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  chats         Chat[]
  documents     Document[]
  folders       ChatFolder[]
  accessGrants  WorkspaceAccess[]
  agentConfig   WorkspaceAgentConfig?
  mcpConnections MCPConnection[]
  widgetWorkspaces WidgetWorkspace[]
  uploadDrafts UploadDraft[]
  // Phase 97 (MEM-01 D-01 — Pitfall 3 per-workspace): memories scoped to this workspace.
  // onDelete: Cascade via Memory.workspaceId FK — workspace deletion cascades memories.
  memories Memory[]
  // Phase 190 (SKIL-01 D-02): workspace-scoped skills.
  // onDelete: Cascade via AgentSkill.workspaceId FK — workspace deletion cascades them.
  skills AgentSkill[]
  // Phase 198 (ECCO-01, D-01): connectors bound to this workspace (hard FK,
  // KB binding mirror of the widget's primary workspace binding). Sessions
  // hang off the connector (no workspaceId FK on ConnectorSession) — reachable
  // via connector.workspace; no direct back-relation.
  connectors ChatConnector[]

  // D-01 (quick 260809-wte): unique per-project name, partial index WHERE "deletedAt" IS NULL (soft-deleted rows free the name).
  @@unique([projectId, name])
  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("workspaces")
}

model Chat {
  id           String   @id @default(uuid())
  // Phase 182 (SAAS-01b, D-02 promise list): direct column for M4 scoping
  // guarantee (today org resolves transitively via workspaceId)
  organizationId String @default("00000000-0000-0000-0000-000000000000")
  workspaceId  String
  name         String   @default("New Chat")
    prompt       String? @db.Text
  // D-01 (Phase 98): "auto" = title gen eligible; "user" = user renamed, skip title gen (Pitfall 10).
  // Enum-as-string pattern (NOT Prisma enum) for consistency with Chat.model (String).
  titleSource  String   @default("auto")
  model        String   @default("qwen2.5:3b")
  temperature  Float    @default(0.7)
  providerId   String?
  folderId     String?
  archiveId    String?
  // Phase 191 (KNOW-02 D-05): chat-attached wiki-archive knowledge — additive
  // scalar list (Prisma 7 scalar list on PostgreSQL, no join table). Prisma 7
  // scalar lists are inherently non-null ("Optional lists are not supported") —
  // an empty list is the "attach nothing" state. Existing chats attach nothing
  // until the user does (no backfill — D-05 agent's discretion); the org-scoped
  // validated subset is mirrored by archiveAttachmentService.syncChatAttachment
  // at each send.
  attachedArchiveIds String[]
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  folder    ChatFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  archive   Archive?     @relation(fields: [archiveId], references: [id], onDelete: SetNull)
  pins      ChatPin[]
  mcpPins   ChatMCPPin[]
  // Phase 198 (ECCO-01, D-01/D-08): persistent chat continuity for external
  // connector sessions — nullable FK (session starts chat-less; the
  // sessionResolver attaches a Chat on the first message), onDelete: SetNull
  // so deleting a chat never cascades into connector session rows.
  connectorSessions ConnectorSession[] @relation("ConnectorChat")

  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("chats")
}

model ChatFolder {
  id             String    @id @default(uuid())
  // Phase 182 (SAAS-01b, D-02 promise list)
  organizationId String    @default("00000000-0000-0000-0000-000000000000")
  workspaceId String
    name        String @db.Text
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chats     Chat[]

  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("chat_folders")
}

model ChatPin {
  userId    String
  chatId    String
  pinnedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([userId, chatId])
  @@map("chat_pins")
}

model ChatMessage {
  id        String   @id @default(uuid())
  // Phase 182 (SAAS-01b, D-02 promise list)
  organizationId String @default("00000000-0000-0000-0000-000000000000")
  chatId    String
  role      String   // "user" | "assistant" | "system"
    content   String @db.Text
    metadata  String? @db.Text  // JSON string for citations, tokens, etc.
  attachedDocumentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  // Phase 97 (MEM-01 D-07 — Pitfall 3 no orphan PII): Memories derived from this
  // message. onDelete: Cascade via Memory.sourceMessageId FK — reaper hard-purge of
  // ChatMessage cascades derived memories automatically; the reaper also issues an
  // explicit Memory.deleteMany + memory.reaper.purge audit (defense-in-depth).
  sourceMemories Memory[] @relation("ChatMessageSourceMemories")

  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
