// Prisma Schema — PostgreSQL Native
// PostgreSQL-only after Phase 22 (Infrastructure Foundation).

generator client {
  provider = "prisma-client-js"
  // D-Prisma7: in Prisma 7, `prisma-client-js` requires an explicit `output` path.
  // We generate into the package-local node_modules (where pnpm hoists nothing)
  // and then symlink node_modules/@prisma/client/.prisma -> ../.prisma/client
  // so the runtime require chain `default.js -> .prisma/client/default -> client.js` works.
  output   = "../node_modules/.prisma/client"
  // Phase 182 (D-05 spike): partial unique index WHERE "deletedAt" IS NULL on
  // OrganizationMember's composite unique — soft-deleted membership rows free
  // the (organizationId, userId) slot for re-add (P2002 tombstone class).
  // PREVIEW in Prisma 7.10.0 (introduced 7.4.0, NOT deprecated — unlike
  // prismaSchemaFolder, which the enterprise fragment header bans).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// RBAC Models
// ============================================================

// ============================================================
// Multi-Tenancy Root (Phase 182 — Tenant Data Model)
// ============================================================

// Organization — the tenancy root. A fixed-UUID "default" org (see
// DEFAULT_ORG_ID in @simmetric-chat/shared) is INSERTed by migration M1
// (NOT the seed — fresh installs run migrate-before-seed and tolerate seed
// failure). Air-gap installs keep behaving single-tenant: every pre-tenancy
// row backfills into the default org (M3) and every new row defaults to it
// (@default(DEFAULT_ORG_ID) on organizationId columns, M4 SET DEFAULT).
model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  // Phase 183/Parte II consume; default-org stays 'free'
  plan      String    @default("free")
  // Soft-delete norm (org deletion = Parte II provisioning story)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  members OrganizationMember[]
  // Back-relations for the Tier-A organizationId columns (Phase 182)
  projects             Project[]
  workspaces           Workspace[]
  chats                Chat[]
  chatFolders          ChatFolder[]
  chatMessages         ChatMessage[]
  documents            Document[]
  archives             Archive[]
  systemConfigs        SystemConfig[]
  providers            Provider[]
  providerModels       ProviderModel[]
  apiKeys              ApiKey[]
  workspaceAgentConfigs WorkspaceAgentConfig[]
  projectAccesses      ProjectAccess[]
  workspaceAccesses    WorkspaceAccess[]
  widgets              Widget[]
  widgetWorkspaces     WidgetWorkspace[]
  workspaceTemplates   WorkspaceTemplate[]
  workspaceTokenUsages WorkspaceTokenUsage[]
  webhooks             Webhook[]
  pushSubscriptions    PushSubscription[]
  mcpConnections       MCPConnection[]
  uploadDrafts         UploadDraft[]
  ocrJobs              OcrJob[]
  archiveImportJobs    ArchiveImportJob[]
  synthesisRuns        SynthesisRun[]
  dlpPatterns          DlpPattern[]
  // Cross-fragment back-relation (schema-enterprise.prisma BackupDestination
  // organizationId — resolves via the prismaSchemaFolder merge, Phase 141
  // verdict; mirrors User.backupDestinations)
  backupDestinations   BackupDestination[]

  @@map("organizations")
}

// OrganizationMember — the ONLY user↔organization link (D-01: User is a
// pure-identity entity, NO organizationId column on User). Removal of a
// member = soft delete of this row (D-04); user-created data stays owned
// by the org — no cascade of tenant data. roleInOrg is a tier ABOVE the
// 31-permission RBAC surface (untouched).
model OrganizationMember {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  // owner | admin | member — enum-as-string pattern (NOT Prisma enum) for
  // consistency with Chat.titleSource (Phase 182 research A8).
  roleInOrg      String    @default("member")
  // D-04: removal = soft delete; seat count = deletedAt IS NULL
  deletedAt      DateTime?
  joinedAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // D-05 (Phase 182): partial unique — soft-deleted rows (tombstones) free
  // the (organizationId, userId) slot so a member can be re-added (P2002
  // tombstone class seen across ×20 soft-deleting tables in v0.20).
  @@unique([organizationId, userId], where: { deletedAt: null })
  // "all orgs for user" lookup (TenantContext resolution hot path, Phase 185)
  @@index([userId])
  // seat-count / member-list queries
  @@index([organizationId])
  @@map("organization_members")
}

model User {
  id           String          @id @default(uuid())
  username     String          @unique
  email        String          @unique
  passwordHash String
  salt         String
  firstName     String?
  lastName      String?
  avatar        String?
  customInstructions String? @db.Text
  textSize      String?
  mustChangePassword Boolean    @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  roles           UserRole[]
  // Phase 182 (D-01): memberships are the ONLY org link — User carries NO
  // organizationId column (identity stays pure); the active org resolves
  // from request context via TenantContext (Phase 185).
  organizationMemberships OrganizationMember[]
  projectAccess   ProjectAccess[]
  workspaceAccess WorkspaceAccess[]
  apiKeys         ApiKey[]
  createdProjects Project[]      @relation("ProjectCreator")
  eventLogs       EventLog[]
  widgets         Widget[]
  chatPins        ChatPin[]
  mcpPins         ChatMCPPin[]
  archives        Archive[]
  archivePages    ArchivePage[]
  ocrJobs         OcrJob[]
  synthesisRuns          SynthesisRun[]  @relation("SynthesisRunCreator")
  approvedSynthesisRuns  SynthesisRun[]  @relation("SynthesisRunApprover")
  wikiEditRuns           WikiEditRun[]  @relation("WikiEditRunCreator")
  approvedWikiEditRuns   WikiEditRun[]  @relation("WikiEditRunApprover")
  archiveImportJobs      ArchiveImportJob[]
  backupDestinations     BackupDestination[]
  restoredBackups        BackupLog[]     @relation("restoredByUserRelation")
  uploadDrafts UploadDraft[]
  // Phase 97 (MEM-01 D-01 — Pitfall 3 per-user): memories authored by this user.
  // onDelete: Cascade via Memory.userId FK — user deletion cascades their memories (GDPR).
  memories Memory[]
  // Phase 113 (SSO): external identity provider links for this user (SAML/OIDC).
  // onDelete: Cascade via IdentityProvider.userId FK — user deletion removes their IdP links.
  identityProviders IdentityProvider[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
    description String? @db.Text
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users       UserRole[]
  permissions RolePermission[]
  menuSections RoleMenuSection[]

  @@map("roles")
}

// Enum-as-table pattern for SQLite compatibility.
// Each row represents a single permission name (e.g. "workspace:read").
model Permission {
  name        String           @id
    description String? @db.Text
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId         String
  permissionName String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionName], references: [name], onDelete: Cascade)

  @@id([roleId, permissionName])
  @@map("role_permissions")
}

model RoleMenuSection {
  roleId      String
  menuSection String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, menuSection])
  @@map("role_menu_sections")
}

model ProjectAccess {
  userId    String
  projectId String
  // Phase 182 (SAAS-01b): access grant pins its org (column only — composite
  // PK untouched)
  organizationId String @default("00000000-0000-0000-0000-000000000000")
  grantedAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  // Phase 182 (SAAS-01b): org-lookup index on the M2 column — declared here so
  // `prisma migrate dev` drift detection keeps the M2-created DB index (the
  // Plan-02 empirical probe proved Prisma proposes DROP INDEX for any DB index
  // absent from the schema).
  @@index([organizationId])
  @@map("project_access")
}

model WorkspaceAccess {
  userId      String
  workspaceId String
  // Phase 182 (SAAS-01b): access grant pins its org (column only — composite
  // PK untouched)
  organizationId String @default("00000000-0000-0000-0000-000000000000")
  grantedAt   DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("workspace_access")
}

// ============================================================
// Domain Models
// ============================================================

model Project {
  id            String    @id @default(uuid())
  // Phase 182 (SAAS-01b): tenant owner. @default pins the air-gap default org —
  // zero create()-site churn until TenantContext replaces it (Phase 185).
  organizationId String   @default("00000000-0000-0000-0000-000000000000")
  // Phase 182 (SAAS-01b): tenant owner. @default pins the air-gap default org —
  // zero create()-site churn until TenantContext replaces it (Phase 185).
    name          String
    description String? @db.Text
  createdBy   String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator      User           @relation("ProjectCreator", fields: [createdBy], references: [id])
  workspaces   Workspace[]
  accessGrants ProjectAccess[]
  mcpConnections MCPConnection[]

  // D-01 (quick 260809-wte): unique per-owner name, partial index WHERE "deletedAt" IS NULL (soft-deleted rows free the name).
  @@unique([createdBy, name])
  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("projects")
}

model Workspace {
  id             String   @id @default(uuid())
  // Phase 182 (SAAS-01b): tenancy boundary for collector/vector layer
  organizationId String   @default("00000000-0000-0000-0000-000000000000")
  projectId      String
  name           String
    instructions   String? @db.Text
  embeddingModel String   @default("Xenova/all-MiniLM-L6-v2")
  allowMemberUploads Boolean @default(true)
  icon           String?
  templateId     String?
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template      WorkspaceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  chats         Chat[]
  documents     Document[]
  folders       ChatFolder[]
  accessGrants  WorkspaceAccess[]
  agentConfig   WorkspaceAgentConfig?
  mcpConnections MCPConnection[]
  widgetWorkspaces WidgetWorkspace[]
  uploadDrafts UploadDraft[]
  // Phase 97 (MEM-01 D-01 — Pitfall 3 per-workspace): memories scoped to this workspace.
  // onDelete: Cascade via Memory.workspaceId FK — workspace deletion cascades memories.
  memories Memory[]

  // D-01 (quick 260809-wte): unique per-project name, partial index WHERE "deletedAt" IS NULL (soft-deleted rows free the name).
  @@unique([projectId, name])
  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("workspaces")
}

model Chat {
  id           String   @id @default(uuid())
  // Phase 182 (SAAS-01b, D-02 promise list): direct column for M4 scoping
  // guarantee (today org resolves transitively via workspaceId)
  organizationId String @default("00000000-0000-0000-0000-000000000000")
  workspaceId  String
  name         String   @default("New Chat")
    prompt       String? @db.Text
  // D-01 (Phase 98): "auto" = title gen eligible; "user" = user renamed, skip title gen (Pitfall 10).
  // Enum-as-string pattern (NOT Prisma enum) for consistency with Chat.model (String).
  titleSource  String   @default("auto")
  model        String   @default("qwen2.5:3b")
  temperature  Float    @default(0.7)
  providerId   String?
  folderId     String?
  archiveId    String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  folder    ChatFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  archive   Archive?     @relation(fields: [archiveId], references: [id], onDelete: SetNull)
  pins      ChatPin[]
  mcpPins   ChatMCPPin[]

  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("chats")
}

model ChatFolder {
  id             String    @id @default(uuid())
  // Phase 182 (SAAS-01b, D-02 promise list)
  organizationId String    @default("00000000-0000-0000-0000-000000000000")
  workspaceId String
    name        String @db.Text
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chats     Chat[]

  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("chat_folders")
}

model ChatPin {
  userId    String
  chatId    String
  pinnedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([userId, chatId])
  @@map("chat_pins")
}

model ChatMessage {
  id        String   @id @default(uuid())
  // Phase 182 (SAAS-01b, D-02 promise list)
  organizationId String @default("00000000-0000-0000-0000-000000000000")
  chatId    String
  role      String   // "user" | "assistant" | "system"
    content   String @db.Text
    metadata  String? @db.Text  // JSON string for citations, tokens, etc.
  attachedDocumentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  // Phase 97 (MEM-01 D-07 — Pitfall 3 no orphan PII): Memories derived from this
  // message. onDelete: Cascade via Memory.sourceMessageId FK — reaper hard-purge of
  // ChatMessage cascades derived memories automatically; the reaper also issues an
  // explicit Memory.deleteMany + memory.reaper.purge audit (defense-in-depth).
  sourceMemories Memory[] @relation("ChatMessageSourceMemories")

  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("chat_messages")
}

model Document {
  id             String    @id @default(uuid())
  // Phase 182 (SAAS-01b, D-02 promise list)
  organizationId String    @default("00000000-0000-0000-0000-000000000000")
  workspaceId    String
  name           String
  type           String    // "pdf" | "md" | "csv" | "docx" | "xlsx" | "txt"
  filePath       String
  /// Phase 184 (SAAS-03, D-05): provider key. NEW rows: {organizationId}/uploads/{uuid}-{safeName}
  /// (drafts subpath: {orgId}/uploads/drafts/…). LEGACY rows backfilled storageKey = filePath
  /// (path-as-key, M6 UPDATE — no file moves). Nullable, NO @default — write sites set it explicitly.
  storageKey     String?
  cacheKey       String    @unique
  chunkCount     Int       @default(0)
  embeddingModel String    @default("Xenova/all-MiniLM-L6-v2")
  status         String    @default("pending")  // "pending" | "processing" | "completed" | "failed"
    statusMessage  String? @db.Text   // Error message if failed
  fileSize       Int       @default(0)
  deletedAt      DateTime?
  /// D-08 — null = pending cleanup, set on 2xx from collector
  vectorCleanupAt DateTime?
  /// IN-02 — purge attempt counter for the vector-cleanup retry job. Bounded
  /// by MAX_VECTOR_CLEANUP_ATTEMPTS so a permanently-failing collector purge
  /// doesn't retry forever / spam logs.
  vectorCleanupAttempts Int @default(0)
  /// IN-02 — tombstone set once vectorCleanupAttempts reaches the cap. The
  /// retry job skips tombstoned docs, surfacing stuck purges to ops.
  vectorCleanupFailedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks    DocumentChunk[]

  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("documents")
}

model DocumentChunk {
  id          String   @id @default(uuid())
  documentId  String
    chunkText   String @db.Text
    metadata    String @db.Text   // JSON: pageNumber, lineStart, lineEnd, paragraph
  embeddingId String   // Reference ID in the Vector DB
  createdAt   DateTime @default(now())
  searchVector Unsupported("tsvector")?
  // Phase 151 (RAG-01): 7-config concatenated tsvector (english||italian||german||french||spanish||russian||simple).
  // Populated by the startup backfill (searchVectorMultiBackfill.ts) + all write sites. Old searchVector retained until v1.3.
  searchVectorMulti Unsupported("tsvector")?

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
  @@index([searchVector], type: Gin)
  @@index([searchVectorMulti], type: Gin)
}

// ============================================================
// LLM Wiki Archive System
// ============================================================

model Archive {
  id            String    @id @default(uuid())
  // Phase 182 (SAAS-01b): KB container — tenant-owned. slug @unique stays
  // GLOBAL per D-06 (org is transitivo via createdBy→membership)
  organizationId String   @default("00000000-0000-0000-0000-000000000000")
  slug          String    @unique
  name          String
  description String?   @db.Text
  createdBy   String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator User          @relation(fields: [createdBy], references: [id])
  pages   ArchivePage[]
  chats         Chat[]
  ocrJobs        OcrJob[]
  synthesisRuns  SynthesisRun[]
  wikiEditRuns   WikiEditRun[]
  archiveImportJobs ArchiveImportJob[]
  uploadDrafts UploadDraft[]
  autoIndex      Boolean           @default(false)
  config         ArchiveConfig?
  templates      ArchiveSchemaTemplate[]

  // D-01 (quick 260809-wte): unique per-owner name, partial index WHERE "deletedAt" IS NULL (soft-deleted rows free the name).
  @@unique([createdBy, name])
  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("archives")
}

model ArchivePage {
  id           String    @id @default(uuid())
  archiveId    String
  slug         String
  title        String
  category     String
  frontmatter  Json?
  bodyText          String    @db.Text
  contentHash          String
  vectorContentHash    String?
  vectorProvider       String?
  lastIndexedAt        DateTime?
  wikilinks         String[]
  createdBy         String
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  searchVector Unsupported("tsvector")?
  // Phase 151 (RAG-01): 7-config concatenated tsvector (english||italian||german||french||spanish||russian||simple).
  // Populated by the startup backfill (searchVectorMultiBackfill.ts) + all write sites. Old searchVector retained until v1.3.
  searchVectorMulti Unsupported("tsvector")?

  // Relations
  archive Archive @relation(fields: [archiveId], references: [id])
  creator User    @relation(fields: [createdBy], references: [id])

  @@unique([archiveId, slug])
  @@index([archiveId, category])
  @@index([searchVector], type: Gin)
  @@index([searchVectorMulti], type: Gin)
  @@map("archive_pages")
}

// ============================================================
// System Configuration
// ============================================================

model SystemConfig {
  id    String @id @default(uuid())
  key   String
  value String
  // Phase 183 (SAAS-02, D-08 swap — the Phase-182 deferral is FULFILLED): the
  // scalar `key @unique` is replaced by the composite `@@unique([organizationId,
  // key])` so two orgs can override the same key (per-tenant config cascade).
  // All ~27 former `where: { key }` call sites (systemConfigService, routes/ocr,
  // routes/filters, routes/chatRetention, seed.ts, routes/system wizard, both
  // operator scripts) were migrated to find-first-then-write in Phase 183 Plans
  // 01/02 (upsertSystemConfigRow helper) — the swap lands compile-clean.
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Phase 183 (D-08 + Pitfall-P1 checkpoint verdict — ADOPT): Postgres composite
  // unique is NULLs-distinct by default, so `(NULL, key)` rows would NOT collide
  // and the helper's P2002 race backstop would never fire for global rows. The
  // partial unique `key WHERE organizationId IS NULL` restores DB-level
  // global-row uniqueness (M1 partial-unique precedent; partialIndexes preview
  // flag enabled repo-wide since Phase 182-01 D-05 spike verdict). Partial
  // indexes cannot arbitrate ON CONFLICT (42P10 — organizationService.ts doc
  // comment) — irrelevant here: every writer is find-first-then-write.
  @@unique([organizationId, key])
  @@unique([key], map: "system_config_key_key_null_org", where: { organizationId: null })

  // Phase 182 (SAAS-01b): org-lookup index on the M2 column. The COLUMN stays
  // nullable (Tier A′ global-row substrate — no M3 backfill, no M4 NOT NULL/
  // SET DEFAULT); this index is drift-locked per the project_access note.
  @@index([organizationId])
  @@map("system_config")
}

// ============================================================
// Provider & Model Management
// ============================================================

model Provider {
  id            String         @id @default(uuid())
  // Phase 182 (SAAS-01b): BYOK per-org seam (DF-04)
  organizationId String        @default("00000000-0000-0000-0000-000000000000")
  name          String
  type          String         // "ollama" | "openai" | "anthropic"
  baseUrl     String
  apiKey      String?        // Encrypted (AES-256-GCM)
  isEnabled   Boolean        @default(true)
  isDefault   Boolean        @default(false)
    lastError   String? @db.Text
  lastSyncAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  models      ProviderModel[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("providers")
}

model ProviderModel {
  id            String   @id @default(uuid())
  // Phase 182 (SAAS-01b): child of Provider (org transitivo via providerId,
  // direct column per the promise-list letter). @@unique([providerId, name])
  // unchanged per D-06
  organizationId String  @default("00000000-0000-0000-0000-000000000000")
  providerId  String
  name        String
  displayName String?
  isLocal     Boolean  @default(false)
  isEnabled   Boolean  @default(true)
  isAvailable Boolean  @default(true)
  isEmbedding Boolean  @default(false)
  isOcr       Boolean  @default(false)
  isDefault   Boolean  @default(false)
  temperature Float?
  maxTokens   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([providerId, name])
  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("provider_models")
}

// ============================================================
// API Keys
// ============================================================

model ApiKey {
  id        String    @id @default(uuid())
  name      String
  prefix    String    @unique  // First 8 chars of plaintext key — display only (D-03, no lookup)
  key_hash  String    @unique  // HMAC-SHA256 hex digest (64 chars) — replaces bcrypt hashedKey (Phase 163, SCALE-03)
