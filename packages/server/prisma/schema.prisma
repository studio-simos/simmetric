model Document {
  id             String    @id @default(uuid())
  // Phase 182 (SAAS-01b, D-02 promise list)
  organizationId String    @default("00000000-0000-0000-0000-000000000000")
  workspaceId    String
  name           String
  type           String    // "pdf" | "md" | "csv" | "docx" | "xlsx" | "txt"
  filePath       String
  /// Phase 184 (SAAS-03, D-05): provider key. NEW rows: {organizationId}/uploads/{uuid}-{safeName}
  /// (drafts subpath: {orgId}/uploads/drafts/…). LEGACY rows backfilled storageKey = filePath
  /// (path-as-key, M6 UPDATE — no file moves). Nullable, NO @default — write sites set it explicitly.
  storageKey     String?
  cacheKey       String    @unique
  chunkCount     Int       @default(0)
  embeddingModel String    @default("Xenova/all-MiniLM-L6-v2")
  status         String    @default("pending")  // "pending" | "processing" | "completed" | "failed" | "cancelled"
    statusMessage  String? @db.Text   // Error message if failed
  /// quick 260918-p3h (D-2): collector-fed ingest progress 0-100, surfaced
  /// through GET /api/documents + the pending-docs polling payloads.
  progress       Int       @default(0)
  /// quick 260918-p3h (D-3): set when the user cancels a running ingest.
  cancelledAt    DateTime?
  fileSize       Int       @default(0)
  deletedAt      DateTime?
  /// D-08 — null = pending cleanup, set on 2xx from collector
  vectorCleanupAt DateTime?
  /// IN-02 — purge attempt counter for the vector-cleanup retry job. Bounded
  /// by MAX_VECTOR_CLEANUP_ATTEMPTS so a permanently-failing collector purge
  /// doesn't retry forever / spam logs.
  vectorCleanupAttempts Int @default(0)
  /// IN-02 — tombstone set once vectorCleanupAttempts reaches the cap. The
  /// retry job skips tombstoned docs, surfacing stuck purges to ops.
  vectorCleanupFailedAt DateTime?
  /// Phase 192 (D-12/D-04): DLP backfill idempotency marker. Null = the DLP
  /// scan has never completed for this document (backfill-eligible); set on
  /// scan completion (clean scans included — zero entity rows is a valid
  /// outcome, the timestamp is the marker). Also gates re-scan eligibility.
  dlpScannedAt DateTime?
  /// Phase 192 (D-12): document scan state machine —
  /// "queued" | "scanning" | "scanned" | "clean" | "failed". Null until the
  /// first scan is enqueued ("clean" = completed with zero entities; the
  /// marker column above is the idempotency truth, this string is UX state).
  dlpScanState String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks    DocumentChunk[]
  // Phase 192 (D-04): entity mapping rows — onDelete: Cascade via DlpEntity
  // FK (document purge removes its encrypted entity rows; no orphan PII).
  dlpEntities DlpEntity[]

  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("documents")
}

