  // Branding fields (Enterprise-only customization, CUST-01)
  logoUrl         String?
  primaryColor    String?   @default("#4c6ef5")
  botName         String?   @default("AI Assistant")
  avatarUrl       String?
    allowedOrigins  String? @db.Text   // JSON array of allowed origin URLs for CORS

  // Display trigger fields (CUST-03, per D-01/D-02/D-03/D-04/D-05)
  autoOpenDelay        Int?      // Seconds before auto-open, null = disabled
  autoOpenUrlPatterns  String?   // JSON array of glob patterns, null = disabled
  exitIntentEnabled    Boolean   @default(false)
  exitIntentCooldownMs Int       @default(1800000) // 30 min in ms per D-04
  // Lead capture fields (ADM-04, per D-06/D-07/D-08)
  leadCaptureEnabled   Boolean   @default(false)
    leadCapturePrompt   String? @db.Text   // Custom prompt text for lead form header

  // Per-widget rate-limit override (SCALE-04, D-05). null = use global default.
  rateLimitPerMinute  Int?

  // Per-widget daily MESSAGE limit (151-02, G-151-1b). null = use global
  // default (5/day prod, 50/day dev). Enforced on the message-send path by
  // widgetDailyMessageLimiter (widget service, per-widget+IP, 24h window).
  sessionLimitPerDay  Int?

  // Per-widget localization + credits (v0.20, D-02..D-05)
  localizedTexts     Json?    // { [locale]: { welcomeMessage?, fallbackMessage?, placeholder?, piiConsent?, leadPrompt? } }
  suggestedQuestions Json?    // { [locale]: string[] } — null = not configured, [] = disabled
  credits            Json?    // { enabled, label, url }
  fallbackLocale     String   @default("en")

  // Bound knowledge archive for widget chat (260809-uxk, D-08 wiki_query
  // binding). Null = unbound. Deliberately NO relation — archives are global
  // (no workspaceId column) and the admin UI validates existence at selection;
  // a stale id degrades gracefully in wiki_query (FTS miss → RAG miss → LLM
  // "no info").
  archiveId         String?

  // Per-widget response model pin (260831-hgy). The LLM provider+model that
  // serves THIS widget's chat responses. Deliberately NO relation — mirrors
  // the archiveId philosophy above: a stale provider/model id degrades
  // gracefully because resolveProviderConfig falls through to the default
  // provider → env fallback; the widget keeps answering. Null = not
  // configured → existing resolution chain (workspace default → global
  // default). responseProviderId is a Provider UUID; responseModel is the
  // model NAME on that provider (mirrors Chat.model, not ProviderModel.id).
  responseProviderId String?
  responseModel      String?

  createdBy       String
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator    User            @relation(fields: [createdBy], references: [id])
  workspaces WidgetWorkspace[]
  sessions   WidgetSession[]
  leads      WidgetLead[]
  events     WidgetEvent[]

  // Phase 182 (SAAS-01b): org-lookup index on the M2 column (drift-locked, see
  // the project_access note).
  @@index([organizationId])
  @@map("widgets")
}

