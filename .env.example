# Simmetric Chat — root .env template
#
# THE single runtime config file for every Node service (server, collector,
# widget). Copy to `.env` and fill in the secrets. Per-package .env files no
# longer exist (the Phase 177 legacy override layer was removed): every key
# lives here, grouped by the package(s) that read it.
#
# Loaded by docker compose (env_file: ../.env) and — at boot of every
# package — by the zero-dependency loadRootEnv() in
# packages/shared/src/config/loadEnv.ts (marker-walk to the repo root).
#
# Resolution order: process.env > this root .env > Zod default.
# Each package's Zod schema (packages/*/src/config/env.ts) is the source of
# truth; this file documents every schema key of every package (guarded by
# the envExampleParity tests — a schema key losing documentation here fails
# the suite). Everything not listed is either a code default, an
# admin-editable SystemConfig key (Settings UI, stored in DB — DB wins over
# env for UI-editable keys), or a raw-read override documented at the bottom
# and in docs/CONFIGURATION.md.
#
# Every key is marked with the package(s) that read it:
#   [server] [collector] [widget] or a combination.

# ═══════════════ Shared / bootstrap (cross-service) ═══════════════

# ── Runtime ──────────────────────────────────────────────────────
# [server|widget] development | production | test
NODE_ENV=development
# [server|collector|widget] debug | info | warn | error. Server schema is a
# 4-value enum; the collector + widget loggers read it RAW at module load
# (plain string there — structural exception, see docs/CONFIGURATION.md).
LOG_LEVEL=info

# ── Service URLs & ports ─────────────────────────────────────────
# [server|collector|widget] Canonical server URL.
SERVER_URL=http://localhost:3000
# [server|collector] Collector ingest service.
COLLECTOR_URL=http://localhost:3210
# [server] Widget service URL for the push cache-bust (:3211). When unset on
# the server side, fireWidgetCacheBust is a no-op (5-min TTL is the net).
WIDGET_SERVICE_URL=http://localhost:3211
# [server] HTTP port.
SERVER_PORT=3000
# [server|collector] Collector HTTP port.
COLLECTOR_PORT=3210
# [widget] Widget service HTTP port.
WIDGET_PORT=3211

# ── Database ────────────────────────────────────────────────────
# [server] Postgres connection — ALWAYS env, never DB (ALWAYS_READONLY).
# Pick the host that matches YOUR setup:
#   host.docker.internal:5432   server on the host, Postgres in Docker
#                                (default — matches docker compose)
#   localhost:5432               everything running on the host
#   postgres:5432               server itself inside the compose network
DATABASE_URL=postgresql://simmetricchat:simmetricchat@host.docker.internal:5432/simmetricchat

# ── Shared secrets (never in DB, never committed) ────────────────
# Generate each with: openssl rand -base64 32
#
# ⚠️ FAIL-LOUD AT BOOT: the two keys below are required (Zod .min(1), no
# default) — the server refuses to start without them.
# [server] Signs JWTs + cookies.
JWT_SECRET=<sostituire-con-valore-generato>
# [server|collector] Sent by the server on X-Collector-Secret (HTTP-only
# boundary).
COLLECTOR_SECRET=<sostituire-con-valore-generato>
# [widget] REQUIRED (Zod .min(1)) — shared secret sent on X-Api-Key to the
# server's /api/internal/widget API. Generate server-side with
# `pnpm --filter server generate-apikey`. [server] Optional counterpart:
# when unset, the push cache-bust is a no-op.
WIDGET_API_KEY=<sostituire-con-valore-generato>
# [server] HMAC-SHA256 signing key for API keys (base64, 32 bytes); strict
# validation at the consumption site (apiKeyService.ts).
# API_KEY_HMAC_SECRET=<sostituire-con-valore-generato>
# [server] AES-256-GCM data-at-rest key (base64, 32 bytes); strict
# validation at the consumption site. Absent = legacy scryptSync(JWT_SECRET)
# derivation. REQUIRED in production (docker/entrypoint-server.sh
# provisions/persists it in /app/storage when not supplied).
# ENCRYPTION_KEY=<sostituire-con-valore-generato>

# ── Optional infra ───────────────────────────────────────────────
# [server|widget] Redis enables horizontal scaling (auth cache, SSE
# fan-out, Bree mutex, rate limits / widget config cache + distributed
# rate-limit store). Absent = graceful single-instance fallback.
# REDIS_URL=redis://localhost:6379

# ── Enterprise license (optional) ────────────────────────────────
# [server] RS256 JWT granting enterprise features. Absent = Community build.
# LICENSE_KEY=

# ═══════════════ [server] — Express API :3000 ═══════════════

# ── Session ──────────────────────────────────────────────────────
# [server] JWT/session expiry in ms (24h default).
SESSION_EXPIRY=86400000

# ── LLM provider ─────────────────────────────────────────────────
# [server] openai | anthropic | ollama | openrouter
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:latest
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
# 0 = no timeout (underpowered local hardware needs unlimited time).
LLM_TIMEOUT=0
# LLM_API_KEY=<sostituire-con-valore-generato>
# LLM_API_BASE_URL=
# OPENAI_API_KEY=<sostituire-con-valore-generato>
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=<sostituire-con-valore-generato>
# ANTHROPIC_MODEL=
# [server|collector] Ollama endpoint. Host-native dev typically runs the
# daemon on http://localhost:11434; docker compose uses http://ollama:11434.
OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=
# OLLAMA_API_KEY=<sostituire-con-valore-generato>
# [server] Server container name for the `docker exec ... ollama login`
# cloud-auth flow (infra config only — no request input reaches the CLI).
OLLAMA_CONTAINER_NAME=simmetric-chat-ollama
# [server|collector] ollama-js keep_alive for warm KV cache (5–30 min
# guidance; never -1/infinite).
OLLAMA_KEEP_ALIVE=10m
# OPENROUTER_API_KEY=<sostituire-con-valore-generato>
OPENROUTER_BASE_URL=https://openrouter.ai/api
# OPENROUTER_MODEL=

# ── Agent watchdogs ──────────────────────────────────────────────
# Each watchdog blocks a specific ReAct-loop failure mode
# (docs/agent-watchdogs.md). LLM_TIMEOUT-style absolute caps.
AGENT_WALLCLOCK_TIMEOUT_MS=600000
AGENT_MAX_TOTAL_TOKENS=200000
AGENT_MAX_CONTEXT_BYTES=500000
AGENT_MAX_TOOL_OUTPUT_LENGTH=5000
AGENT_MAX_SKILL_EXECUTION_MS=60000
AGENT_LOOP_DETECTION_WINDOW=3
CHAT_MAX_CONCURRENT_PER_USER=5
# Char cap for the rendered <memory_context> block (marker/wrapper excluded).
AGENT_MEMORY_CHAR_LIMIT=2000
# Auto-extraction fires every N turns post-done; 0 disables it.
AGENT_MEMORY_REVIEW_INTERVAL=10
# Cosine-similarity dedup threshold before add (tunable 0.85..0.99).
AGENT_MEMORY_DEDUP_THRESHOLD=0.92

# ── OCR ──────────────────────────────────────────────────────────
# Supports model:version format.
OCR_MODEL=glm-ocr:latest
OCR_TIMEOUT=600000
OCR_NUM_PREDICT=8192

# ── Synthesis ─────────────────────────────────────────────────────
SYNTHESIS_LLM_MODEL=gemma4:latest

# ── Embedding / vector store (shared with the collector) ──────────
# [server|collector] local | openai | ollama | hf-local — shared schema.
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=
# EMBEDDING_API_KEY=<sostituire-con-valore-generato>
# [server|collector] lancedb | qdrant | pgvector | chroma — the pgvector URL
# is served from DATABASE_URL via /api/system/vector-db-config.
VECTOR_DB_PROVIDER=lancedb
# VECTOR_DB_URL=
# VECTOR_DB_API_KEY=<sostituire-con-valore-generato>

# ── Feature gates ────────────────────────────────────────────────
ALLOW_REGISTRATION=false
# Web search hard gate + SearXNG endpoint + optional Tavily fallback key.
ALLOW_WEB_SEARCH=false
SEARXNG_URL=http://localhost:8888
# TAVILY_API_KEY=<sostituire-con-valore-generato>

# ── Bootstrap admin ──────────────────────────────────────────────
# Auto-seeded on first startup when no admin exists (idempotent). Disable
# with: false | 0 | no | off | "" (a literal "false" really disables it).
SEED_BOOTSTRAP_ADMIN=true
SEED_ADMIN_USERNAME=admin
# Well-known one-shot bootstrap credential: the seeded account carries
# mustChangePassword=true and MUST be rotated at first login. Override in
# prod / air-gap deploys.
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin@example.com

# ── Telemetry / license ──────────────────────────────────────────
# No phone-home by default (docs/DEPLOYMENT.md § telemetry).
DISABLE_TELEMETRY=true

# ── SCIM / MCP secrets ────────────────────────────────────────────
# SCIM 2.0 Bearer token; unset = all SCIM endpoints 404 (stealth mode).
# SCIM_BEARER_TOKEN=<sostituire-con-valore-generato>
# MCP Bearer shared secret for /api/mcp/sse + /api/mcp/message; unset =
# localhost-only fallback + boot warn.
# MCP_API_KEY=<sostituire-con-valore-generato>

# ── OIDC / SSO (Enterprise) ──────────────────────────────────────
# Env overrides the DB SsoConfig row. All optional; when unset the admin SSO
# settings panel stays the source of truth. Same boolean semantics as
# SEED_BOOTSTRAP_ADMIN (a literal "false" disables).
# OIDC_ENABLED=
# google | github | microsoft | oidc ("oidc" = custom IdP via discovery URL)
# OIDC_PROVIDER=
# OIDC_DISCOVERY_URL=
# OIDC_CLIENT_ID=
# Plaintext env secret (no at-rest encryption; DB path encrypts instead).
# OIDC_CLIENT_SECRET=<sostituire-con-valore-generato>
# OIDC_REDIRECT_URI=
# Space-delimited; consumption default "openid email profile".
# OIDC_SCOPE=openid email profile

# ── Web Push (VAPID) ─────────────────────────────────────────────
# Unset public/private pair = ephemeral dev keys generated with a warn.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=<sostituire-con-valore-generato>
# Consumption default "mailto:admin@simmetric-chat.local".
# VAPID_SUBJECT=

# ── SMTP (password-reset + backup notifications) ─────────────────
# Unset = the related features log-and-skip instead of failing.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=<sostituire-con-valore-generato>
# SMTP_FROM=

# ── Misc integrations ────────────────────────────────────────────
# Puppeteer/Chromium executable for archive PDF export (consumption-site
# default /usr/bin/chromium-browser).
# PUPPETEER_EXECUTABLE_PATH=
# CORS allowlist (CSV). Trimmed, empties dropped; empty/absent falls back to
# the dev-friendly default list below.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ═══════════════ [collector] — ingest pipeline :3210 ═══════════════

# Document storage root for ingested sources.
STORAGE_PATH=./storage
# ONNX-quantized community reranker (loads via @huggingface/transformers).
# NOT BAAI/bge-reranker-v2-m3 — that ships safetensors-only and throws at
# pipeline() load time under JS.
RERANKER_MODEL=Xenova/bge-reranker-base
# Optional cache-dir override; when unset falls back to HF_CACHE_DIR, then
# the HF v3 default cache dir.
# RERANKER_CACHE_DIR=

# ═══════════════ [widget] — embeddable service :3211 ═══════════════

# The widget reads ONLY these 6 schema keys — all defined in the Shared
# section above (kept active there, listed here for discoverability):
#   NODE_ENV · WIDGET_PORT · SERVER_URL · WIDGET_API_KEY (required) ·
#   LOG_LEVEL (plain string, not the server enum) · REDIS_URL

# ═══════════════ Raw-read keys (pointer only — NOT schema keys) ═══════════════
# Deliberately OUTSIDE the Zod schemas, read raw from process.env;
# semantics documented in docs/CONFIGURATION.md. No active assignments are
# invented for them here.
# [server] LEGACY_PREVIOUS_ENCRYPTION_KEYS — decrypt key-chain tail during
#   ENCRYPTION_KEY rotation (docs/ENCRYPTION_KEY_ROTATION.md).
# [server] E2E_RUN=1 — authRateLimiter skip gate for Playwright runs.
# [collector] HF_CACHE_DIR / XENOVA_CACHE_DIR — HF/xenova model cache dirs.
#   AIR-GAP LANDMINE: never leave them inside node_modules — `pnpm install`
#   wipes packages/*/@huggingface/transformers cache contents.
# [collector] HF_ALLOW_REMOTE_MODELS — remote model download gate for the
#   hf-local path (air-gap stance: false).
# [collector] OPENAI_API_KEY — raw dual-path channel on the collector
#   (embeddings.ts). It IS a server schema key (documented in the [server]
#   LLM section above); on the collector it is raw-only.